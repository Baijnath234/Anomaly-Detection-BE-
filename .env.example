# Server Environment
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=anomaly_detection

# Redis Configuration (BullMQ Background Worker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Model Persistence Storage Path
MODEL_STORAGE_PATH=./storage/models

# Anthropic Claude API Key (Optional for Grounded AI Repair Explanations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration (Optional for Password Reset OTP via Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
